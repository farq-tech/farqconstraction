# macOS AppleDouble sidecars. This volume is exFAT/SMB, so every file gets a
# `._name` twin that carries no source and shadows ignore rules for the real
# file (`._.env.local` is not matched by `.env*`).
._*
.DS_Store

node_modules/
dist/
build/
.cache/
.env*
!.env.example
# Vercel CLI link state + pulled env (holds a short-lived OIDC token).
.vercel/
.vite/
vite.config.*.timestamp-*
*.tsbuildinfo
*-debug.log*
logs/
*.log
.claude-replay.*
.tmp-*
/.figma/design-context/

# Platform-managed agentplat state, not project source. In the
# client-initiated single-repo workspace layout (make's `Path: "."` spec) the
# repo root IS the workspace root, so these land inside this repo rather than
# beside it.
/.plugins/
/.opencode-skills/
.vercel
