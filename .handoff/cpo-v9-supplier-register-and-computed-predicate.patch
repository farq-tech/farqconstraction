+  const DECIDING = ['strong_terms', 'weak_terms'] as const
+  const key = (t: string) => t.toLowerCase().trim()
+
+  /** term -> families where it can DECIDE. term -> every family that uses it at all. */
+  const decidesIn = new Map<string, Set<string>>()
