diff --git a/api/tests/critical-offers-readiness.test.js b/api/tests/critical-offers-readiness.test.js
new file mode 100644
index 000000000..83689055b
--- /dev/null
+++ b/api/tests/critical-offers-readiness.test.js
@@ -0,0 +1,134 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+  evaluateCriticalOffersReadiness,
+} = require('../lib/server-readiness');
+const {
+  criticalOffersGatedShapes,
+  readReusableCacheEnvelope,
+  readGatedOffersCacheState,
+} = require('../lib/search/warmBiggestSavings');
+// Build fixtures with the real writer so this cannot drift from the envelope.
+const { wrapEnvelope, hardTtlSec, softTtlSec } = require('../lib/comparison-http-cache');
+
+const warmKey = (label) => ({ label, key: `k:${label}`, ok: true, age: 'hit' });
+const coldKey = (label) => ({ label, key: `k:${label}`, ok: false, reason: 'missing' });
+const warmMins = { ok: true, key: 'mins', age: 'hit' };
+
+test('readiness is warm only when every gated key is reusable', () => {
+  const state = evaluateCriticalOffersReadiness({
+    required: true,
+    offers: { ok: true, keys: [warmKey('a'), warmKey('b')] },
+    mins: warmMins,
+  });
+  assert.equal(state.ready, true);
+  assert.equal(state.status, 'warm');
+  assert.deepEqual(state.reason_codes, []);
+  assert.equal(state.keys.length, 3);
+});
+
+test('readiness can regress — the defect the latch could not express', () => {
+  // Same process, later probe, one key expired. A latched boolean physically
+  // could not report this; that is why it is asserted here.
+  const state = evaluateCriticalOffersReadiness({
+    required: true,
+    offers: { ok: false, keys: [warmKey('a'), coldKey('b')] },
+    mins: warmMins,
+  });
+  assert.equal(state.ready, false);
+  assert.equal(state.status, 'cold');
+  // The historical code stays first so uptime monitors keep matching.
+  assert.equal(state.reason_codes[0], 'critical_offers_warmup_pending');
+  assert.ok(state.reason_codes.includes('critical_offers_key_cold'));
+  // And it names which key, which the old 503 never did.
+  assert.deepEqual(
+    state.keys.filter((entry) => !entry.ok).map((entry) => entry.label),
+    ['b'],
+  );
+});
+
+test('an unanswerable probe is not ready', () => {
+  // A failed Redis probe must not read as a yes. Gmail reported CURRENT while
+  // syncing nothing by making exactly this substitution.
+  for (const args of [
+    { required: true, offers: null, mins: warmMins },
+    { required: true, offers: { ok: true, keys: [warmKey('a')] }, mins: null },
+    { required: true, offers: { ok: true, keys: [] }, mins: warmMins },
+  ]) {
+    const state = evaluateCriticalOffersReadiness(args);
+    assert.equal(state.ready, false);
+    assert.ok(state.reason_codes.includes('critical_offers_probe_unavailable'));
+  }
+});
+
+test('the gate is not required when the production flag is off', () => {
+  const state = evaluateCriticalOffersReadiness({ required: false });
+  assert.equal(state.ready, true);
+  assert.equal(state.status, 'not_required');
+  assert.deepEqual(state.reason_codes, []);
+});
+
+test('a warm key with zero rows is ready — rows are a data question', async () => {
+  // sort=percent answers {ok:true, items:[]} in production while being fully
+  // cached. Requiring rows here would hold the gate closed over a correct
+  // cache, which is the boot latch rebuilt with a new mechanism.
+  const body = JSON.stringify({ ok: true, items: [] });
+  const cacheStore = { get: async () => wrapEnvelope(body, Date.now()) };
+  const probe = await readReusableCacheEnvelope(cacheStore, 'any');
+  assert.equal(probe.ok, true, 'an empty but fresh envelope is reusable');
+
+  const state = await readGatedOffersCacheState({ cacheStore });
+  assert.equal(state.ok, true);
+  assert.equal(state.keys.length, criticalOffersGatedShapes().length);
+});
+
+test('a missing or stale envelope is not reusable', async () => {
+  const missing = await readReusableCacheEnvelope({ get: async () => null }, 'k');
+  assert.equal(missing.ok, false);
+  assert.equal(missing.reason, 'missing');
+
+  const dead = Date.now() - (hardTtlSec() + 60) * 1000;
+  const missed = await readReusableCacheEnvelope(
+    { get: async () => wrapEnvelope('{"ok":true,"items":[]}', dead) },
+    'k',
+  );
+  assert.equal(missed.ok, false);
+  assert.equal(missed.reason, 'age_miss');
+
+  // A probe that throws is a failure, not a pass.
+  const broken = await readReusableCacheEnvelope(
+    { get: async () => { throw new Error('redis down'); } },
+    'k',
+  );
+  assert.equal(broken.ok, false);
+  assert.equal(broken.reason, 'probe_failed');
+});
+
+test('a stale-but-serveable key is ready, and does not flap the gate', async () => {
+  // The soft TTL is 600s and the rewarm cycle 480s, so one missed cycle tips a
+  // key stale. The route still serves it instantly and revalidates behind the
+  // request, so the reader pays nothing and readiness must not go red.
+  const justStale = Date.now() - (softTtlSec() + 60) * 1000;
+  const probe = await readReusableCacheEnvelope(
+    { get: async () => wrapEnvelope('{"ok":true,"items":[]}', justStale) },
+    'k',
+  );
+  assert.equal(probe.ok, true);
+  assert.equal(probe.age, 'stale');
+  assert.equal(probe.degraded, true, 'reported, but not a reason to hold traffic');
+});
+
+test('pool exhaustion is treated as transient so boot retries it', () => {
+  const { isTransientWarmFailure } = require('../lib/search/warmBiggestSavings');
+  const poolFull = {
+    ok: false,
+    error: '(EMAXCONNSESSION) max clients reached in session mode - max clients are limited to pool_size: 20',
+  };
+  assert.equal(isTransientWarmFailure(poolFull), true, 'the 2026-09-16 boot failure');
+  assert.equal(isTransientWarmFailure({ ok: false, error: 'query timeout' }), true);
+  // Not everything is worth retrying.
+  assert.equal(isTransientWarmFailure({ ok: false, error: 'syntax error at or near' }), false);
