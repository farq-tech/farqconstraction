+/*
+ * Railway must keep the previous healthy deployment on traffic until the
+ * latency-sensitive Offers key is reusable on the new process.
+ *
+ * This used to be a boolean latched by the boot warmer. On 2026-09-16 the
+ * pooler refused four shapes during a 50-second, process-wide connection
+ * shortage; the warmer returned not-ok, the latch closed, and because the boot
+ * queue never retries and nothing else could reach the variable, /health served
+ * 503 critical_offers_warmup_pending for hours — over a cache that was already
+ * warm and answering in 3–8ms, inherited through Redis from the previous
+ * deployment. The signal described a past attempt, not the present world.
+ *
+ * So: recomputed per probe from the keys themselves, briefly memoised so a
+ * monitor cannot turn a health check into Redis load. It can go green without a
+ * restart, and it can go red again if the cache genuinely decays.
+ */
+const CRITICAL_OFFERS_READINESS_TTL_MS = 5_000;
+let criticalOffersReadinessCache = { at: 0, value: null };
+
+async function loadCriticalOffersReadiness() {
+  // The read-only canary's /health contract is credential-free and explicitly
+  // forbids touching Redis, so it cannot answer this question and must not
+  // pretend to. Readiness there is decided by the branch below it.
+  if (readOnlyCanary) {
+    return evaluateCriticalOffersReadiness({ required: false });
+  }
+  if (!comparisonSavingsReadinessRequired) {
+    return evaluateCriticalOffersReadiness({ required: false });
+  }
+  const now = Date.now();
+  if (
+    criticalOffersReadinessCache.value
+    && now - criticalOffersReadinessCache.at < CRITICAL_OFFERS_READINESS_TTL_MS
+  ) {
+    return criticalOffersReadinessCache.value;
+  }
+  let offers = null;
+  let mins = null;
+  try {
+    const { readGatedOffersCacheState } = require('./lib/search/warmBiggestSavings');
+    const { readCategoryMinsCacheState } = require('./lib/search/warmCheapestCategoryMins');
+    [offers, mins] = await Promise.all([
+      readGatedOffersCacheState(),
+      readCategoryMinsCacheState(),
+    ]);
+  } catch (error) {
+    logger.warn({ err: error.message }, '[readiness] critical offers probe failed');
+  }
+  const value = evaluateCriticalOffersReadiness({
+    required: comparisonSavingsReadinessRequired,
+    offers,
+    mins,
+  });
+  criticalOffersReadinessCache = { at: now, value };
+  return value;
