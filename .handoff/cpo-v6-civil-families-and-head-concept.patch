+function attributeRegions(rawText: string): Array<[number, number]> {
+  const text = ensureNormalized(rawText)
+  if (!text) return []
+  const starts: number[] = []
+  for (const key of ATTRIBUTE_CLAUSE_KEYS) {
+    const normalized = normalizeTerm(key)
+    for (const at of allTermIndices(text, normalized)) {
+      if (at <= 0) continue
+      starts.push(at)
+    }
+  }
+  if (!starts.length) return []
+  starts.sort((a, b) => a - b)
+  // A clause runs from its keyword to the next keyword, or to end of line.
+  const regions: Array<[number, number]> = []
+  for (let i = 0; i < starts.length; i++) {
+    const end = i + 1 < starts.length ? starts[i + 1]! : text.length
+    regions.push([starts[i]!, end])
+  }
+  return regions
