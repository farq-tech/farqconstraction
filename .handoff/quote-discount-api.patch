diff --git a/api/tests/construction-quote-discount-requests.test.js b/api/tests/construction-quote-discount-requests.test.js
new file mode 100644
index 000000000..bd2d36848
--- /dev/null
+++ b/api/tests/construction-quote-discount-requests.test.js
@@ -0,0 +1,102 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const { PGlite } = require('@electric-sql/pglite');
+const { createDiscountRequests, canSchedule, validate } = require('../lib/construction/quote-discount-requests');
+const id = n => `00000000-0000-4000-8000-${String(n).padStart(12,'0')}`;
+const actor = { actorId: id(1), userId: id(2), role: 'PROCUREMENT', requestScope: 'OWN_REQUESTS' };
+const env = { CONSTRUCTION_ENTITLEMENTS: '0', CONSTRUCTION_WRITE_ENABLED: '1', CONSTRUCTION_INBOX_WORKER_ENABLED: '1', CONSTRUCTION_INBOX_ROUTING_V1: '1', CONSTRUCTION_INBOX_WORK_OWNERS: id(1) };
+async function fixture() {
+  const db = new PGlite();
+  await db.exec(`create role anon; create role authenticated; create role construction_owner; create role farq_construction_app; create schema auth; create schema construction;
+    create table auth.users(id uuid primary key);
+    create table construction.rfqs(id uuid primary key,buyer_user_id uuid,assigned_user_id uuid,current_version_id uuid,status text);
+    create table construction.rfq_versions(id uuid primary key,rfq_id uuid);
+    create table construction.rfq_invites(id uuid primary key,rfq_version_id uuid);
+    create table construction.supplier_quotes(invite_id uuid,current_version_id uuid);
+    create table construction.supplier_quote_versions(id uuid primary key);
+    create table construction.inbox_messages(id uuid primary key,invite_id uuid,channel text,correspondence_captured boolean,received_at timestamptz);
+    create table construction.inbox_outbox(id uuid primary key,state text,failure_code text);
+    create table construction.awards(rfq_id uuid,status text);
+    create table construction.access_users(user_id uuid,scope_owner_user_id uuid,role text,request_scope text,active boolean);
+    insert into auth.users values('${id(1)}'),('${id(2)}');
+    insert into construction.rfqs values('${id(3)}','${id(1)}','${id(2)}','${id(4)}','SENT');
+    insert into construction.rfq_versions values('${id(4)}','${id(3)}');
+    insert into construction.rfq_invites values('${id(5)}','${id(4)}');
+    insert into construction.supplier_quotes values('${id(5)}','${id(6)}');
+    insert into construction.supplier_quote_versions values('${id(6)}'),('${id(7)}');
+    insert into construction.access_users values('${id(2)}','${id(1)}','PROCUREMENT','OWN_REQUESTS',true);`);
+  await db.exec('grant usage on schema construction to farq_construction_app');
+  await db.exec(fs.readFileSync(require('node:path').join(__dirname,'../db/migrations/construction/20261005120000_construction_quote_discount_requests.sql'),'utf8'));
+  // Exercise the runtime role's actual new-table RLS/grants, not only superuser access.
+  await db.exec('set role farq_construction_app');
+  await db.query('select * from construction.quote_discount_requests');
+  await db.exec('reset role');
+  const pool = { query: (sql,args) => db.query(sql,args), connect: async () => ({ query: (sql,args) => db.query(sql,args), release() {} }) };
+  const sends = [];
+  let uncertain = false;
+  const requests = createDiscountRequests({ pool, env,
+    authorize: async (_, a) => a.actorId === id(1) ? {} : null,
+    reply: async (input, internal) => {
+      await internal.beforeSend(pool);
+      sends.push({ input, internal });
+      await db.query('insert into construction.inbox_outbox(id,state) values($1,$2)',[input.body.idempotency_key, uncertain ? 'SENDING' : 'SENT']);
+      if (uncertain) throw Error('provider outcome unknown');
+      return { id: input.body.idempotency_key, state: 'SENT' };
+    },
+  });
+  const body = { idempotency_key: id(8), quote_version_id: id(6), delay_minutes: 60, text: 'نرجو تخفيض إجمالي العرض' };
+  const create = (changes = {}, a = actor) => requests.create({ actor: a, params: { id: id(5) }, body: { ...body, ...changes } });
+  const due = () => db.exec("update construction.quote_discount_requests set send_at=now()-interval '1 minute'");
+  return { db, requests, sends, create, due, uncertain: () => { uncertain = true } };
+}
+test('schedule persists, sends only when due as Ahmad, and replays never duplicate', async () => {
+  const f = await fixture();
+  try {
+    const row = await f.create(); assert.equal(row.state,'SCHEDULED');
+    const delay = new Date(row.send_at).getTime() - Date.now(); assert.ok(delay > 3590000 && delay <= 3600000);
+    await f.requests.runDue(id(1)); assert.equal(f.sends.length,0);
+    assert.equal((await f.create()).id,row.id);
+    await f.due(); await f.requests.runDue(id(1)); await f.requests.runDue(id(1));
+    assert.equal(f.sends.length,1); assert.equal(f.sends[0].internal.employeeName,'رد آلي من فرق');
+    assert.equal((await f.requests.list({actor,params:{id:id(5)}})).requests[0].state,'SENT');
+    await assert.rejects(f.create({idempotency_key:id(9)}),e=>e.code==='DISCOUNT_ALREADY_REQUESTED');
+  } finally { await f.db.close() }
+});
+test('immediate discount uses original actor and normal inbox path', async () => {
+  const f = await fixture(); try {
+    assert.equal((await f.create({delay_minutes:0})).state,'SENT');
+    assert.equal(f.sends.length,1); assert.equal(f.sends[0].internal.employeeName,null);
