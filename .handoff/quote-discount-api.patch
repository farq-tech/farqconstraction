--- /dev/null
+++ b/api/db/migrations/construction/20261005120000_construction_quote_discount_requests.sql
@@ -0,0 +1,24 @@
+create table construction.quote_discount_requests (
+  id uuid primary key,
+  invite_id uuid not null references construction.rfq_invites(id),
+  quote_version_id uuid not null references construction.supplier_quote_versions(id),
+  owner_id uuid not null references auth.users(id),
+  actor_user_id uuid not null references auth.users(id),
+  parent_message_id uuid references construction.inbox_messages(id),
+  channel text not null,
+  text text not null check(length(text) between 1 and 4000),
+  delay_minutes integer not null check(delay_minutes in (0,60)),
+  send_at timestamptz not null,
+  state text not null default 'SCHEDULED' check(state in ('SCHEDULED','PROCESSING','SENT','FAILED','UNKNOWN','SKIPPED','CANCELLED')),
+  failure_code text,
+  outbox_id uuid references construction.inbox_outbox(id),
+  created_at timestamptz not null default now(),
+  updated_at timestamptz not null default now()
+);
+create unique index quote_discount_once_per_version on construction.quote_discount_requests(invite_id,quote_version_id) where state <> 'CANCELLED';
+create index quote_discount_due on construction.quote_discount_requests(send_at) where state='SCHEDULED';
+alter table construction.quote_discount_requests owner to construction_owner;
+alter table construction.quote_discount_requests enable row level security;
+revoke all on construction.quote_discount_requests from public, anon, authenticated;
+grant select, insert, update on construction.quote_discount_requests to farq_construction_app;
+create policy quote_discount_backend on construction.quote_discount_requests to farq_construction_app using (true) with check (true);
