@@ -256,6 +256,9 @@ function createConstructionRouter(options = {}) {
   router.post('/inbox/requests/:id/owner', read, write, buyer, replyLimit, inboxCall('claim'));
   router.post('/inbox/threads/:id/work-action', read, write, buyer, inboxCall('workAction'));
   router.post('/inbox/threads/:id/state', read, write, buyer, replyLimit, inboxCall('setState'));
+  router.get('/inbox/threads/:id/discount-requests', read, buyer, requirePackage('READ'), inboxCall('listDiscountRequests'));
