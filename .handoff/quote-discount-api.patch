diff --git a/api/lib/construction/quote-discount-requests.js b/api/lib/construction/quote-discount-requests.js
new file mode 100644
index 000000000..9e2e2c748
--- /dev/null
+++ b/api/lib/construction/quote-discount-requests.js
@@ -0,0 +1,112 @@
+'use strict';
+const { UUID, fail } = require('./inbox-mail');
+const { rfqScopeSql } = require('./request-scope');
+
+function canSchedule(env, ownerId) {
+  return env.CONSTRUCTION_WRITE_ENABLED === '1' && env.CONSTRUCTION_INBOX_WORKER_ENABLED === '1' && env.CONSTRUCTION_INBOX_ROUTING_V1 === '1'
+    && String(env.CONSTRUCTION_INBOX_WORK_OWNERS || '').split(',').map(s => s.trim()).includes(ownerId);
+}
+function validate(body) {
+  if (!UUID.test(body.idempotency_key || '') || !UUID.test(body.quote_version_id || '')
+    || ![0, 60].includes(body.delay_minutes) || typeof body.text !== 'string' || !body.text.trim()
+    || body.text.length > 4000 || /\u0000/.test(body.text)) throw fail(400, 'DISCOUNT_INVALID_REQUEST');
+}
+function publicRequest(row) {
+  return { id: row.id, quote_version_id: row.quote_version_id, text: row.text, send_at: row.send_at, state: row.state, failure_code: row.failure_code || null };
+}
+function createDiscountRequests({ pool, env, authorize, reply }) {
+  const entitlements = require('./entitlements').createEntitlements({ pool, env });
+  async function transaction(fn) {
+    const client = await pool.connect();
+    try { await client.query('begin'); const result = await fn(client); await client.query('commit'); return result; }
+    catch(e) { await client.query('rollback'); throw e; } finally { client.release(); }
+  }
+  async function eligible(client, actor, inviteId, quoteVersionId) {
+    const result = (await client.query(`select r.id rfq_id,q.current_version_id from construction.rfq_invites i
+      join construction.rfq_versions v on v.id=i.rfq_version_id join construction.rfqs r on r.id=v.rfq_id
+      join construction.supplier_quotes q on q.invite_id=i.id
+      where i.id=$1 and r.buyer_user_id=$2${rfqScopeSql(actor, 'r')}
+      and r.current_version_id=i.rfq_version_id and r.status::text not in ('CANCELLED','AWARDED')
+      and not exists(select 1 from construction.awards a where a.rfq_id=r.id and a.status::text <> 'CANCELLED')
+      for update of r,q`, [inviteId, actor.actorId])).rows[0];
+    if (!result || result.current_version_id !== quoteVersionId) throw fail(409, 'DISCOUNT_QUOTE_CHANGED_OR_AWARDED');
+    return result;
+  }
+  async function list({ actor, params }) {
+    const t = await authorize(pool, actor, params.id, false);
+    if (!t) return null;
+    const rows = (await pool.query('select * from construction.quote_discount_requests where invite_id=$1 order by created_at desc', [params.id])).rows;
+    return { requests: rows.map(publicRequest), can_schedule: canSchedule(env, actor.actorId) };
+  }
+  async function create({ actor, params, body = {} }) {
+    validate(body);
+    if (body.delay_minutes && !canSchedule(env, actor.actorId)) throw fail(503, 'DISCOUNT_SCHEDULER_UNAVAILABLE');
+    const row = await transaction(async client => {
+      const t = await authorize(client, actor, params.id, true); if (!t) return null;
+      await eligible(client, actor, params.id, body.quote_version_id);
+      const prior = (await client.query('select * from construction.quote_discount_requests where id=$1', [body.idempotency_key])).rows[0];
+      if (prior) {
+        if (prior.invite_id !== params.id || prior.actor_user_id !== actor.userId || prior.quote_version_id !== body.quote_version_id || prior.text !== body.text.trim() || prior.delay_minutes !== body.delay_minutes) throw fail(409, 'INBOX_IDEMPOTENCY_CONFLICT');
+        return prior;
+      }
+      const latest = (await client.query('select id,channel from construction.inbox_messages where invite_id=$1 and correspondence_captured order by received_at desc,id desc limit 1', [params.id])).rows[0];
+      // Match the supplier's inbound channel. FORM quotes use the portal when enabled, otherwise email.
+      const channel = latest && ['EMAIL','WHATSAPP','HARAJ','PORTAL'].includes(latest.channel) ? latest.channel : null;
+      try {
+        return (await client.query(`insert into construction.quote_discount_requests(id,invite_id,quote_version_id,owner_id,actor_user_id,parent_message_id,channel,text,delay_minutes,send_at)
+          values($1,$2,$3,$4,$5,$6,$7,$8,$9,now()+($9::int * interval '1 minute')) returning *`,
+          [body.idempotency_key, params.id, body.quote_version_id, actor.actorId, actor.userId, latest?.id || null, channel || 'DEFAULT', body.text.trim(), body.delay_minutes])).rows[0];
+      } catch(e) { if (e.code === '23505') throw fail(409, 'DISCOUNT_ALREADY_REQUESTED'); throw e; }
+    });
+    if (!row) return null;
+    if (row.delay_minutes === 0 && row.state === 'SCHEDULED') return publicRequest(await execute(row.id));
+    return publicRequest(row);
+  }
+  async function cancel({ actor, params }) {
+    return transaction(async client => {
+      if (!(await authorize(client, actor, params.id, true))) return null;
+      const result = (await client.query(`update construction.quote_discount_requests set state='CANCELLED',updated_at=now()
+        where id=$1 and invite_id=$2 and owner_id=$3 and state='SCHEDULED' returning *`, [params.discountId, params.id, actor.actorId])).rows[0];
+      if (!result) throw fail(409, 'DISCOUNT_NOT_SCHEDULED');
+      return publicRequest(result);
+    });
+  }
+  async function execute(id) {
+    // Claim once across workers. A crashed/uncertain dispatch is never blindly retried.
+    const row = (await pool.query("update construction.quote_discount_requests set state='PROCESSING',updated_at=now() where id=$1 and state='SCHEDULED' and send_at<=now() returning *", [id])).rows[0];
+    if (!row) return (await pool.query('select * from construction.quote_discount_requests where id=$1', [id])).rows[0];
+    let state = 'UNKNOWN', failureCode = null, outboxId = null;
+    try {
+      const user = (await pool.query(`select role,request_scope from construction.access_users where user_id=$1 and active
+        and coalesce(scope_owner_user_id,user_id)=$2 and role in ('ADMIN','PROCUREMENT')`, [row.actor_user_id, row.owner_id])).rows[0];
+      if (!user) throw fail(403, 'INBOX_FORBIDDEN');
+      if (entitlements.enabled && !(await entitlements.access(row.owner_id)).can_send) throw fail(402, 'CONSTRUCTION_PACKAGE_REQUIRED');
+      const actor = { userId: row.actor_user_id, actorId: row.owner_id, role: user.role, requestScope: user.request_scope };
+      const result = await reply({ actor, params: { id: row.invite_id }, body: { idempotency_key: row.id, parent_message_id: row.parent_message_id, text: row.text,
+        ...(row.channel === 'DEFAULT' ? {} : { channel: row.channel }) } }, {
+        employeeName: row.delay_minutes === 60 ? 'رد آلي من فرق' : null,
+        beforeSend: client => eligible(client, actor, row.invite_id, row.quote_version_id),
+      });
+      if (!result) throw fail(404, 'INBOX_FORBIDDEN');
+      state = result.state === 'SENT' ? 'SENT' : result.state === 'FAILED' ? 'FAILED' : 'UNKNOWN';
+      failureCode = result.failure_code || null; outboxId = result.id;
+    } catch(e) {
+      // Once an outbox exists, reconcile its real outcome instead of inferring failure from a thrown exception.
+      const outbox = (await pool.query('select id,state,failure_code from construction.inbox_outbox where id=$1', [row.id])).rows[0];
+      if (outbox) { state = outbox.state === 'SENT' ? 'SENT' : outbox.state === 'FAILED' ? 'FAILED' : 'UNKNOWN'; outboxId = outbox.id; failureCode = outbox.failure_code || e.code || 'DISCOUNT_SEND_UNKNOWN'; }
+      else { state = e.status && e.status < 500 ? 'SKIPPED' : 'FAILED'; failureCode = e.code || 'DISCOUNT_SEND_FAILED'; }
+    }
+    return (await pool.query('update construction.quote_discount_requests set state=$2,failure_code=$3,outbox_id=$4,updated_at=now() where id=$1 returning *', [row.id, state, failureCode, outboxId])).rows[0];
+  }
+  async function runDue(ownerId) {
+    if (!canSchedule(env, ownerId)) return { checked: 0 };
+    if (!(await pool.query("select to_regclass('construction.quote_discount_requests') is not null present")).rows[0]?.present) return { checked: 0 };
+    await pool.query(`update construction.quote_discount_requests set state='UNKNOWN',failure_code='DISCOUNT_RECONCILIATION_REQUIRED',updated_at=now()
+      where owner_id=$1 and state='PROCESSING' and updated_at<now()-interval '10 minutes'`, [ownerId]);
+    const due = (await pool.query("select id from construction.quote_discount_requests where owner_id=$1 and state='SCHEDULED' and send_at<=now() order by send_at limit 5", [ownerId])).rows;
+    for (const row of due) await execute(row.id);
+    return { checked: due.length };
+  }
+  return { list, create, cancel, runDue };
+}
+module.exports = { createDiscountRequests, canSchedule, validate, publicRequest };
