new file mode 100644
index 000000000..61ccb3c1e
--- /dev/null
+++ b/Frontend/src/lib/nominationPool.test.ts
@@ -0,0 +1,58 @@
+/**
+ * The suppliers screen scores a pool to decide فرق's nominations, and that
+ * decision is what the RFQ is built from. `supplierPool` folds in the whole
+ * catalog directory so the buyer can search every active supplier, but a
+ * directory row arrives with no product_match and cannot clear the evidence
+ * gate. ConstructionPage therefore scores `nominationPool` — the matched rows
+ * and the lines' own suppliers — and leaves the directory to the search box.
+ *
+ * This guards the property that makes that safe: adding bare directory rows to
+ * the pool changes nothing about who is nominated. Measured against the
+ * production directory it held for all 37 families tried; the fixture below is
+ * real production rows for one of them.
+ */
+import { describe, expect, it } from 'vitest'
+import type { ConstructionSupplier } from '../types/construction'
+import { autoSelectSuppliersForRequest } from './constructionSupplierAutoSelect'
+import fixture from './nominationPool.fixture.json'
+
+const matched = fixture.matched as unknown as ConstructionSupplier[]
+const bare = fixture.bare as unknown as ConstructionSupplier[]
+const lines = [{ farq_spec_id: fixture.fam, searchComplete: true, text: fixture.line.name as string }]
+
+const nominate = (pool: ConstructionSupplier[]) =>
+  autoSelectSuppliersForRequest(pool, lines)[0]!
+const identity = (selection: ReturnType<typeof nominate>) =>
+  (selection.chosen ?? []).map((entry) => [
+    entry.supplier.id,
+    entry.score,
+    entry.grade,
+    entry.preapproved,
+  ])
+
+describe('the pool that decides nominations', () => {
+  it('is not changed by adding the catalog directory to it', () => {
+    const lean = nominate(matched)
+    // Dedupe order mirrors the page: the evidence-matched entry comes last.
+    const withDirectory = nominate([...bare, ...matched])
+
+    expect(identity(withDirectory)).toEqual(identity(lean))
+    expect(withDirectory.state).toBe(lean.state)
+    expect(withDirectory.qualifiedCount).toBe(lean.qualifiedCount)
+    expect(withDirectory.preapprovedCount).toBe(lean.preapprovedCount)
+
+    // Not vacuous: this family really does nominate somebody.
+    expect(identity(lean).length).toBeGreaterThan(0)
+    expect(bare.length).toBeGreaterThan(0)
+  })
+
+  it('rejects every directory row rather than ranking it', () => {
+    // This is why the directory is only ever cost: each bare row is scored and
+    // then refused, so scoring 11,727 of them buys the same answer more slowly.
+    const withDirectory = nominate([...bare, ...matched])
+    const nominatedIds = new Set(identity(withDirectory).map(([id]) => id))
+    for (const supplier of bare) {
+      expect(nominatedIds.has(supplier.id)).toBe(false)
+    }
+  })
+})
