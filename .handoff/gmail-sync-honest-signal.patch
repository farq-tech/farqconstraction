index 000000000..8a549db20
--- /dev/null
+++ b/api/lib/construction/gmail-sync-signal.js
@@ -0,0 +1,201 @@
+'use strict';
+
+/*
+ * Reasons recorded for the audit trail that are not a person's problem: mail
+ * that arrived before any invite existed is ordinary traffic to info@farq.sa,
+ * and production shows eight such against four of anything else. Counting it as
+ * a fault would pin this signal permanently red on a healthy mailbox.
+ *
+ * The inbox lane's unlanded `inbox-routing.js` defines the same list as
+ * NON_ACTIONABLE_REASONS; when that lands, import it from there instead of
+ * keeping a second copy. It is duplicated here only because this patch targets
+ * the deployed revision, where that module does not yet exist.
+ */
+const NON_ACTIONABLE_REASONS = ['NO_ELIGIBLE_INVITE', 'SELF_SENDER', 'EXCLUDED_LABEL', 'NO_SENDER', 'INVALID_TIMESTAMP'];
+
+/*
+ * An honest answer to "is company mail being captured?".
+ *
+ * `construction.gmail_sync_state.state` is a record of the last pass, and as a
+ * record it is fine. What was wrong was reporting it as the signal: 'CURRENT'
+ * means "page-walking reached the end of the window", which is an attempt, not
+ * a property. On 2026-09-16 the owner asked why nothing was being captured and
+ * the inbox answered «اكتمل آخر فحص» — true, and silent about the outcome. The
+ * real answer was already in `inbox_arrivals`: twelve messages had been examined
+ * and none could be tied to an RFQ (eight arrived before any invite existed).
+ *
+ * So the signal is derived here, at read time, from the row plus what the
+ * looking actually found. Three consequences, matching the readiness contract
+ * in .handoff/READINESS_SIGNAL_DISCIPLINE_2026_09_16.md:
+ *
+ *   - Recomputed. Nothing new is persisted; no writer has to remember.
+ *   - Can regress. Every count is windowed, so `CAPTURING` decays back to
+ *     `NOTHING_ARRIVED`, and `RECENT` decays to `STALE`, with no event needed.
+ *   - Measures the property. Two independent questions are kept apart instead
+ *     of collapsed into one word: did we look, and what did looking find.
+ *
+ * The distinction that matters most: a quiet mailbox captures nothing and is
+ * perfectly healthy. `NOTHING_ARRIVED` is therefore not a fault, and treating
+ * zero captures as a fault would only move the lie. What is a fault is mail
+ * arriving that we cannot account for, and that is `ARRIVED_UNROUTED` and
+ * `NEEDS_ATTENTION` — states the row could not express at all.
+ */
+
+/**
+ * The worker checks about once a minute; five missed intervals is stale. Owned
+ * here rather than in the component so the API and the UI cannot drift on what
+ * "recent" means — the client used to hold this number alone.
+ */
+const LOOK_STALE_MS = 300_000;
+
+/** How far back the outcome counts look. Windowed so they can go back down. */
+const WINDOW_HOURS = 24;
+
+/**
+ * What looking found, scoped to Gmail. `inbox_arrivals` is the right source
+ * because it is the table that records every examined message — captured or
+ * not — which is exactly what an outcome signal needs and what the row lacks.
+ *
+ * Requires CONSTRUCTION_INBOX_ROUTING_V1: under strict routing every examined
+ * message becomes a capture or an arrival, so these counts are complete. With
+ * strict routing off, excluded messages leave no arrival and `arrived` would
+ * undercount — see the handoff for why that is a behavioural fix, not this one.
+ */
+/*
+ * `unexplained` is the count that decides whether a person is needed, and it is
+ * deliberately narrower than `unrouted`.
+ *
+ * Most unrouted mail is ordinary traffic to info@farq.sa that predates every
+ * invite — production shows eight such against four of anything else. The
+ * routing engine already classes that as non-actionable, so counting it as a
+ * fault would pin the signal permanently red on a healthy mailbox: the same
+ * error as calling zero captures a failure, in the other direction.
+ */
+const ACCOUNTING_SQL = `
+  select
+    count(*) filter (where recent)::int arrived,
+    count(*) filter (where recent and state = 'RESOLVED')::int captured,
+    count(*) filter (where recent and state = 'NO_MATCH')::int unrouted,
+    count(*) filter (where recent and state = 'NO_MATCH'
+      and coalesce(evidence->>'reason','') <> all($3::text[]))::int unexplained,
+    count(*) filter (where state in ('AMBIGUOUS','CONFLICT'))::int needs_attention,
+    max(ingested_at) newest_arrival_at
+  from (
+    select state, evidence, ingested_at,
+           ingested_at > now() - ($2 || ' hours')::interval recent
+    from construction.inbox_arrivals
+    where owner_id = $1 and provider = 'GMAIL'
+  ) arrivals`;
+
+/*
+ * Why the *unexplained* messages could not be routed. Scoped to the same set as
+ * the `unexplained` count so the sentence's total and its reasons agree: the
+ * non-actionable bulk is reported as a count, not itemised as if it were a
+ * problem to solve.
+ */
+const REASONS_SQL = `
+  select evidence->>'reason' reason, count(*)::int n
+  from construction.inbox_arrivals
+  where owner_id = $1 and provider = 'GMAIL' and state = 'NO_MATCH'
+    and ingested_at > now() - ($2 || ' hours')::interval
+    and coalesce(evidence->>'reason','') <> all($3::text[])
+  group by 1 order by n desc, 1 limit 4`;
+
+/**
+ * Read the outcome evidence. Never throws: a reporting path must not be able to
+ * break the screen it reports on, and an unavailable probe is reported as
+ * unavailable rather than silently as zero — zero would read as "nothing
+ * arrived", which is the false green this module exists to remove.
+ */
+async function readGmailSyncAccounting(db, ownerId, { windowHours = WINDOW_HOURS } = {}) {
+  try {
+    const [totals, reasons] = await Promise.all([
+      db.query(ACCOUNTING_SQL, [ownerId, String(windowHours), NON_ACTIONABLE_REASONS]),
+      db.query(REASONS_SQL, [ownerId, String(windowHours), NON_ACTIONABLE_REASONS]),
+    ]);
+    return {
+      available: true,
+      window_hours: windowHours,
+      ...totals.rows[0],
+      reasons: reasons.rows.filter((row) => row.reason),
+    };
+  } catch {
+    return { available: false, window_hours: windowHours, reasons: [] };
+  }
+}
+
+/**
+ * Did we look, and recently? Separate from what looking found, because the two
+ * fail independently: a healthy pipe over a quiet mailbox and a dead pipe over
+ * a busy one both produce zero captures, and the owner needs to tell them apart.
+ */
+function evaluateLooking(row, now) {
+  if (!row) return { looking: 'NEVER', last_look_age_seconds: null };
+  const checkedAt = row.checked_at ? Date.parse(row.checked_at) : NaN;
+  const ageMs = Number.isFinite(checkedAt) ? Math.max(0, now - checkedAt) : null;
+  const age = ageMs === null ? null : Math.round(ageMs / 1000);
+  if (row.state === 'UNAVAILABLE') return { looking: 'FAILING', last_look_age_seconds: age };
+  if (row.state === 'NOT_STARTED' || !row.checked_at) return { looking: 'NEVER', last_look_age_seconds: age };
+  // A pass in flight is the one state where the row is already honest.
+  if (row.state === 'SYNCING') return { looking: 'IN_FLIGHT', last_look_age_seconds: age };
+  if (ageMs === null || ageMs > LOOK_STALE_MS) return { looking: 'STALE', last_look_age_seconds: age };
+  return { looking: 'RECENT', last_look_age_seconds: age };
+}
+
+/**
+ * What did looking find? Ordered by what the owner must act on first.
+ * `UNKNOWN` when the evidence could not be read — an unanswerable question is
+ * not a yes.
+ */
+function evaluateOutcome(accounting) {
+  if (!accounting || accounting.available !== true) return 'UNKNOWN';
+  if (Number(accounting.needs_attention) > 0) return 'NEEDS_ATTENTION';
+  // Unexplained mail outranks captures. Measured against production this is the
+  // difference between an answer and a non-answer: one capture beside twelve
+  // unrouted messages would otherwise report 'CAPTURING', which is what the
+  // owner was already being told when he asked why capture was near zero.
+  if (Number(accounting.unexplained) > 0) return 'ARRIVED_UNROUTED';
+  if (Number(accounting.captured) > 0) return 'CAPTURING';
+  return 'NOTHING_ARRIVED';
+}
+
+/**
+ * `healthy` answers only "is anything wrong that a person should act on".
+ * A quiet mailbox is healthy. Mail we examined and could not route is not,
+ * even though the old row called that CURRENT.
+ */
+function evaluateGmailSyncSignal({ row = null, accounting = null, now = Date.now() } = {}) {
+  const { looking, last_look_age_seconds } = evaluateLooking(row, now);
+  const outcome = evaluateOutcome(accounting);
+  const looked = looking === 'RECENT' || looking === 'IN_FLIGHT';
+  return {
+    looking,
+    outcome: looked ? outcome : 'UNKNOWN',
+    healthy: looked && (outcome === 'CAPTURING' || outcome === 'NOTHING_ARRIVED'),
+    last_look_age_seconds,
+    failure_code: row?.failure_code || null,
+    stale_after_seconds: LOOK_STALE_MS / 1000,
+    window_hours: accounting?.window_hours ?? WINDOW_HOURS,
+    arrived: accounting?.available ? Number(accounting.arrived) : null,
+    captured: accounting?.available ? Number(accounting.captured) : null,
+    unrouted: accounting?.available ? Number(accounting.unrouted) : null,
+    unexplained: accounting?.available ? Number(accounting.unexplained) : null,
+    // Unrouted mail that is nobody's problem, reported so the numbers in the
+    // owner's sentence add up without him needing the reason taxonomy.
+    unrelated: accounting?.available
+      ? Number(accounting.unrouted) - Number(accounting.unexplained)
+      : null,
+    needs_attention: accounting?.available ? Number(accounting.needs_attention) : null,
+    reasons: accounting?.reasons || [],
+  };
+}
+
+module.exports = {
+  NON_ACTIONABLE_REASONS,
+  LOOK_STALE_MS,
+  WINDOW_HOURS,
+  ACCOUNTING_SQL,
+  REASONS_SQL,
+  readGmailSyncAccounting,
+  evaluateGmailSyncSignal,
+};
diff --git a/api/tests/construction-gmail-sync-signal.test.js b/api/tests/construction-gmail-sync-signal.test.js
new file mode 100644
index 000000000..3ce9e8fae
--- /dev/null
+++ b/api/tests/construction-gmail-sync-signal.test.js
@@ -0,0 +1,177 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const {
+  LOOK_STALE_MS,
+  readGmailSyncAccounting,
+  evaluateGmailSyncSignal,
+} = require('../lib/construction/gmail-sync-signal');
+
+const NOW = Date.parse('2026-09-16T17:28:56.000Z');
+const at = (msAgo) => new Date(NOW - msAgo).toISOString();
+const accounting = (over = {}) => ({
+  available: true,
+  window_hours: 24,
+  arrived: 0,
+  captured: 0,
+  unrouted: 0,
+  unexplained: 0,
+  needs_attention: 0,
+  reasons: [],
+  ...over,
+});
+
+test('the exact production row that lied: CURRENT while nothing was captured', () => {
+  // Real values read from production on 2026-09-16: the pass had completed 20s
+  // earlier, so the row said CURRENT and the screen said «اكتمل آخر فحص», while
+  // twelve examined messages had failed to route.
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(20_000), completed_at: at(20_000), failure_code: null },
+    accounting: accounting({
+      arrived: 13, captured: 1, unrouted: 12, unexplained: 4,
+      reasons: [{ reason: 'NO_EXPLICIT_CONTEXT', n: 4 }],
+    }),
+    now: NOW,
+  });
+  assert.equal(signal.looking, 'RECENT', 'the pipe genuinely was working');
+  assert.equal(signal.outcome, 'ARRIVED_UNROUTED', 'and that is what the row could not say');
+  assert.equal(signal.healthy, false);
+  assert.equal(signal.unrouted, 12);
+  // One capture must not outrank twelve unrouted messages: that precedence is
+  // what would have repeated the original non-answer.
+  assert.equal(signal.captured, 1);
+  assert.equal(signal.unexplained, 4);
+  assert.equal(signal.unrelated, 8, 'ordinary mail, counted but not blamed');
+  assert.deepEqual(signal.reasons.map((r) => r.reason), ['NO_EXPLICIT_CONTEXT']);
+});
+
+test('a quiet mailbox is healthy — the false red a naive fix would create', () => {
+  // Zero captures must not read as a fault, or we would have moved the lie
+  // rather than removed it.
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(20_000), failure_code: null },
+    accounting: accounting(),
+    now: NOW,
+  });
+  assert.equal(signal.outcome, 'NOTHING_ARRIVED');
+  assert.equal(signal.healthy, true);
+  assert.equal(signal.arrived, 0);
+});
+
+test('"we looked and found nothing" and "we did not look" are different states', () => {
+  const base = accounting();
+  const looked = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(20_000) }, accounting: base, now: NOW,
+  });
+  const didNotLook = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(LOOK_STALE_MS + 60_000) }, accounting: base, now: NOW,
+  });
+  assert.equal(looked.looking, 'RECENT');
+  assert.equal(didNotLook.looking, 'STALE');
+  // Same row state, same counts, opposite meaning for the owner.
+  assert.equal(looked.healthy, true);
+  assert.equal(didNotLook.healthy, false);
+  assert.equal(didNotLook.outcome, 'UNKNOWN', 'counts say nothing if we stopped looking');
+});
+
+test('the signal regresses with no writer and no restart', () => {
+  // Identical row, only the clock moved. A DB-persisted status could not do
+  // this: nothing ever writes CURRENT back to a worse value.
+  const row = { state: 'CURRENT', checked_at: at(20_000), failure_code: null };
+  const fresh = evaluateGmailSyncSignal({ row, accounting: accounting({ arrived: 3, captured: 3 }), now: NOW });
+  assert.equal(fresh.outcome, 'CAPTURING');
+  assert.equal(fresh.healthy, true);
+
+  const later = evaluateGmailSyncSignal({ row, accounting: accounting({ arrived: 3, captured: 3 }), now: NOW + LOOK_STALE_MS + 1_000 });
+  assert.equal(later.looking, 'STALE', 'goes red on the age of the same row');
+  assert.equal(later.healthy, false);
+
+  // And the outcome decays on its own as the window slides past the captures.
+  const quiet = evaluateGmailSyncSignal({ row, accounting: accounting(), now: NOW });
+  assert.equal(quiet.outcome, 'NOTHING_ARRIVED');
+});
+
+test('ordinary unrelated mail alone stays healthy', () => {
+  // Eight messages that predate every invite is what info@farq.sa looks like on
+  // a normal day. Blaming the pipe for them would pin the signal red forever —
+  // the same error as calling a quiet mailbox broken, in the other direction.
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(20_000) },
+    accounting: accounting({ arrived: 8, unrouted: 8, unexplained: 0 }),
+    now: NOW,
+  });
+  assert.equal(signal.outcome, 'NOTHING_ARRIVED');
+  assert.equal(signal.healthy, true);
+  assert.equal(signal.unrelated, 8);
+});
+
+test('unresolved arrivals outrank everything else', () => {
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(1_000) },
+    accounting: accounting({ arrived: 5, captured: 4, needs_attention: 1 }),
+    now: NOW,
+  });
+  assert.equal(signal.outcome, 'NEEDS_ATTENTION');
+  assert.equal(signal.healthy, false, 'work is waiting on a person');
+});
+
+test('a failing pass is reported as failing, with its code', () => {
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'UNAVAILABLE', checked_at: at(30_000), failure_code: 'HTTP_429' },
+    accounting: accounting({ arrived: 2, captured: 2 }),
+    now: NOW,
+  });
+  assert.equal(signal.looking, 'FAILING');
+  assert.equal(signal.failure_code, 'HTTP_429');
+  assert.equal(signal.healthy, false, 'past captures do not excuse a failing pipe');
+});
+
+test('unreadable evidence is not a green', () => {
+  // The Gmail lie was a green over an unknown; do not rebuild it.
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'CURRENT', checked_at: at(1_000) },
+    accounting: { available: false, window_hours: 24, reasons: [] },
+    now: NOW,
+  });
+  assert.equal(signal.outcome, 'UNKNOWN');
+  assert.equal(signal.healthy, false);
+  assert.equal(signal.arrived, null, 'null, not 0 — 0 would read as "nothing arrived"');
+});
+
+test('a missing row, and a row that never ran, are not healthy', () => {
+  for (const row of [null, { state: 'NOT_STARTED', checked_at: null }]) {
+    const signal = evaluateGmailSyncSignal({ row, accounting: accounting(), now: NOW });
+    assert.equal(signal.looking, 'NEVER');
+    assert.equal(signal.healthy, false);
+  }
+});
+
+test('a mid-pass row is trusted, since SYNCING already meant what it said', () => {
+  const signal = evaluateGmailSyncSignal({
+    row: { state: 'SYNCING', checked_at: at(3_000) },
+    accounting: accounting({ arrived: 1, captured: 1 }),
+    now: NOW,
+  });
+  assert.equal(signal.looking, 'IN_FLIGHT');
+  assert.equal(signal.outcome, 'CAPTURING');
+});
+
+test('the accounting probe reports unavailable instead of throwing', async () => {
+  // A reporting path must not be able to break the screen it reports on.
+  const broken = await readGmailSyncAccounting(
+    { query: async () => { throw new Error('relation does not exist'); } },
+    'owner',
+  );
+  assert.equal(broken.available, false);
+  assert.deepEqual(broken.reasons, []);
+
+  const ok = await readGmailSyncAccounting({
+    query: async (sql) => (/group by/i.test(sql)
+      ? { rows: [{ reason: 'NO_ELIGIBLE_INVITE', n: 8 }, { reason: null, n: 1 }] }
+      : { rows: [{ arrived: 9, captured: 0, unrouted: 9, unexplained: 9, needs_attention: 0, newest_arrival_at: at(0) }] }),
+  }, 'owner');
+  assert.equal(ok.available, true);
+  assert.equal(ok.arrived, 9);
+  assert.deepEqual(ok.reasons, [{ reason: 'NO_ELIGIBLE_INVITE', n: 8 }], 'null reasons dropped');
+});
