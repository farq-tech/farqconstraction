diff --git a/api/tests/construction-inbox-routing-domain.test.js b/api/tests/construction-inbox-routing-domain.test.js
new file mode 100644
index 000000000..11b57848b
--- /dev/null
+++ b/api/tests/construction-inbox-routing-domain.test.js
@@ -0,0 +1,93 @@
+'use strict';
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { narrowRfqCandidates, domainCandidates, emailDomain, exclusionReason,
+  NON_ACTIONABLE_REASONS } = require('../lib/construction/inbox-routing');
+const { chooseInvite } = require('../lib/construction/gmail-sync');
+
+const rfq = 'd9e7fbd7-1261-413e-a3d0-155061aded0d';
+const glass = { id: 'aaaaaaaa-1111-4111-8111-111111111111', rfq_id: rfq, created_at: '2026-09-10T23:07:09Z', emails: ['info@glasslineco.com'], name_ar: 'زجاج', name_en: 'Glassline' };
+const other = { id: 'bbbbbbbb-2222-4222-8222-222222222222', rfq_id: rfq, created_at: '2026-09-10T23:07:09Z', emails: ['sales@othersupplier.com'], name_ar: 'مورد', name_en: 'Other' };
+const third = { id: 'cccccccc-3333-4333-8333-333333333333', rfq_id: rfq, created_at: '2026-09-10T23:07:09Z', emails: ['bids@thirdco.com'], name_ar: 'ثالث', name_en: 'Third' };
+
+test('a reply from another mailbox on the supplier domain narrows to that supplier', () => {
+  const pool = [glass, other, third];
+  const narrowed = narrowRfqCandidates(pool, [], null, 'estimation@glasslineco.com');
+  assert.deepEqual(narrowed.map((c) => c.id), [glass.id]);
+});
+
+test('shared mail domains never narrow, even when one invited supplier uses them', () => {
+  const consumer = { ...glass, emails: ['glassline.sales@gmail.com'] };
+  const pool = [consumer, other, third];
+  // Exactly one invited supplier is on gmail.com, so a naive domain rule would
+  // hand every gmail reply to them. It must stay ambiguous instead.
+  assert.deepEqual(domainCandidates(pool, 'someone.else@gmail.com'), []);
+  assert.equal(narrowRfqCandidates(pool, [], null, 'someone.else@gmail.com').length, 3);
+  for (const shared of ['outlook.com', 'hotmail.com', 'yahoo.com', 'icloud.com', 'proton.me']) {
+    assert.deepEqual(domainCandidates([{ ...glass, emails: [`x@${shared}`] }], `y@${shared}`), []);
+  }
+});
+
+test('a domain shared by several invited suppliers stays ambiguous rather than picking one', () => {
+  const sister = { ...other, id: 'dddddddd-4444-4444-8444-444444444444', emails: ['quotes@glasslineco.com'] };
+  const narrowed = narrowRfqCandidates([glass, sister, third], [], null, 'estimation@glasslineco.com');
+  assert.equal(narrowed.length, 2, 'both invited suppliers on the domain survive');
+  assert.ok(narrowed.length > 1, 'more than one candidate keeps the decision ambiguous');
+});
+
+test('the exact address on file still wins, and narrowing never returns empty', () => {
+  const byEmail = [other];
+  assert.deepEqual(narrowRfqCandidates([glass, other], byEmail, null, 'estimation@glasslineco.com').map((c) => c.id), [other.id]);
+  // Evidence discipline: a present signal must never come back empty, or it
+  // reads as a contradiction and holds real replies.
+  for (const address of ['nobody@unknown-domain.com', '', null, 'malformed', '@nodomain.com']) {
+    assert.ok(narrowRfqCandidates([glass, other], [], null, address).length > 0);
+  }
+});
+
+test('emailDomain ignores malformed senders', () => {
+  assert.equal(emailDomain('a@b.com'), 'b.com');
+  assert.equal(emailDomain('UPPER@Example.COM'), 'example.com');
+  assert.equal(emailDomain('@nodomain.com'), null);
+  assert.equal(emailDomain('nodomain'), null);
+  assert.equal(emailDomain(null), null);
+});
+
+test('end to end: the Glassline reply resolves instead of sitting ambiguous', () => {
+  const message = {
+    id: 'ff01',
+    internalDate: String(Date.parse('2026-09-16T05:35:19Z')),
+    snippet: '',
+    payload: { mimeType: 'text/plain', headers: [
+      { name: 'From', value: 'Jessie Pericon <estimation@glasslineco.com>' },
+      { name: 'Subject', value: 'Re: طلب عرض سعر ELE-RFQ-D9E7FBD7 — القسم الكهربائي' },
+    ], body: { data: Buffer.from('quotation attached').toString('base64url') } },
+  };
+  const pool = [glass, other, third].map((c) => ({ ...c, references: [] }));
+  const decided = chooseInvite(message, pool, () => null, true);
+  assert.equal(decided.ambiguous, undefined, 'no longer ambiguous');
+  assert.equal(decided.id, glass.id);
+  assert.equal(decided.routing.state, 'RESOLVED');
+});
+
+test('a supplier answering a request this database lost gets its own reason', () => {
+  const reply = { subject: 'Re: طلب عرض سعر ELE-RFQ-2BE693F2 — توريد المواد الكهربائية' };
+  assert.equal(exclusionReason('NO_ELIGIBLE_INVITE', reply), 'REPLY_TO_UNKNOWN_RFQ');
+  // The token may only survive in the snippet when the subject was rewritten.
+  assert.equal(exclusionReason('NO_ELIGIBLE_INVITE', { subject: 'Quotation', snippet: 'regarding CIV-RFQ-507DC0A0' }), 'REPLY_TO_UNKNOWN_RFQ');
+});
+
+test('automated mail stays non-actionable, including threaded support desks', () => {
+  for (const subject of [
+    'Turn on Advanced Protection',
+    '[Case #28602145866089001] Manual registration failure',
+    'Your AI visibility changed this week',
+  ]) assert.equal(exclusionReason('NO_ELIGIBLE_INVITE', { subject }), 'NO_ELIGIBLE_INVITE');
+  assert.ok(NON_ACTIONABLE_REASONS.includes('NO_ELIGIBLE_INVITE'));
+  assert.ok(!NON_ACTIONABLE_REASONS.includes('REPLY_TO_UNKNOWN_RFQ'), 'orphaned replies stay visible');
+});
+
+test('reasons that already describe a routing decision are never rewritten', () => {
+  for (const reason of ['NO_SENDER', 'SELF_SENDER', 'EXCLUDED_LABEL', 'INVALID_TIMESTAMP'])
+    assert.equal(exclusionReason(reason, { subject: 'Re: ELE-RFQ-2BE693F2' }), reason);
+});
