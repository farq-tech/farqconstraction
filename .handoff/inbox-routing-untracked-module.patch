+'use strict';
+
+// Shared inbound-routing signals. Both the Gmail reconciliation path and the
+// Resend webhook path must read the same evidence from a message, otherwise a
+// Zendesk-style reply routes on one channel and is held on the other.
+const { mailbox } = require('./inbox-mail');
+
+const clean = (s, n) => String(s || '').replace(/\u0000/g, '').slice(0, n);
+
+/** ELE-RFQ-51D17AF6 / RFQ-51D17AF6 from subject, snippet, or body text. */
+function extractRfqTokens(...parts) {
+  const text = parts.map((p) => String(p || '')).join('\n').toUpperCase();
+  return [...new Set([...text.matchAll(/(?:^|[^A-Z0-9])RFQ-([A-F0-9]{8})(?=$|[^A-Z0-9])/g)].map((m) => m[1]))];
+}
+
+function foldName(value) {
+  return String(value || '')
+    .toLowerCase()
+    .normalize('NFKC')
+    .replace(/[\u064B-\u065F\u0670]/g, '')
+    .replace(/[^\p{L}\p{N}]+/gu, '')
+    .slice(0, 120);
+}
+
+/** "دهانات الجزيرة via Zendesk" <agent@…> → دهانات الجزيرة */
+function fromDisplayName(fromHeader) {
+  const raw = String(fromHeader || '').trim();
+  if (!raw || /[\r\n\u0000]/.test(raw)) return null;
+  const angled = raw.match(/^"?([^"<>]+)"?\s*<[^>]+>$/);
+  let name = (angled ? angled[1] : (!raw.includes('@') ? raw : '')).trim();
+  if (!name) return null;
+  name = name.replace(/\s+via\s+\S.*$/i, '').trim();
+  return name.slice(0, 160) || null;
+}
+
+function senderLabel(fromHeader) {
+  const display = fromDisplayName(fromHeader);
+  const email = mailbox(fromHeader);
+  if (display && email) return clean(`${display} <${email}>`, 320);
+  return display || email || null;
+}
+
+/**
+ * Mail domains shared by unrelated senders. A hit here proves nothing about
+ * identity, so narrowing on one would hand a supplier's quote to whichever
+ * invited supplier happens to use that provider — a wrong attribution, which is
+ * worse than staying ambiguous. Free/consumer providers only; a supplier's own
+ * domain is exactly the signal we want to keep.
+ */
+const SHARED_EMAIL_DOMAINS = new Set([
+  'gmail.com', 'googlemail.com',
+  'hotmail.com', 'hotmail.co.uk', 'outlook.com', 'outlook.sa', 'live.com', 'msn.com',
+  'yahoo.com', 'yahoo.co.uk', 'ymail.com', 'rocketmail.com',
+  'icloud.com', 'me.com', 'mac.com', 'aol.com',
+  'proton.me', 'protonmail.com', 'gmx.com', 'gmx.net', 'mail.com', 'zoho.com',
+  'yandex.com', 'yandex.ru', 'mail.ru', 'bk.ru', 'list.ru', 'inbox.ru',
+  'qq.com', '163.com', '126.com', 'naver.com', 'daum.net', 'hanmail.net', 'rediffmail.com',
+  'web.de', 't-online.de', 'free.fr', 'orange.fr', 'laposte.net', 'libero.it', 'sfr.fr',
+]);
+
+function emailDomain(value) {
+  const at = String(value || '').lastIndexOf('@');
+  return at < 1 ? null : String(value).slice(at + 1).toLowerCase() || null;
+}
+
+/**
+ * Invites whose supplier holds an address on the sender's own domain. Empty for
+ * shared providers, and empty when the sender has no usable domain: callers
+ * treat an empty result as "no narrowing", never as a contradiction.
+ */
+function domainCandidates(candidates, address) {
+  const domain = emailDomain(address);
+  if (!domain || SHARED_EMAIL_DOMAINS.has(domain)) return [];
+  return candidates.filter((c) => (c.emails || []).some((e) => emailDomain(e) === domain));
+}
+
+function nameOverlap(display, candidate) {
+  const d = foldName(display);
+  if (!d || d.length < 2) return false;
+  return [candidate.name_ar, candidate.name_en]
+    .map(foldName)
+    .filter((n) => n.length >= 2)
+    .some((n) => d.includes(n) || n.includes(d));
+}
+
+/** Prefer unique RFQ hit; if many invites share the RFQ, narrow by email then From display name. Fail closed. */
+function narrowRfqCandidates(byRfq, byEmail, display, address) {
+  if (byRfq.length <= 1) return byRfq;
+  const emailHit = byRfq.filter((c) => byEmail.some((e) => e.id === c.id));
+  if (emailHit.length === 1) return emailHit;
+  if (emailHit.length > 1) return emailHit;
+  // Replying from another mailbox on the company's own domain — estimation@,
+  // sales@, a named person — is ordinary supplier behaviour, so the address on
+  // file misses a genuine quote. The domain narrows it; returning several
+  // invites keeps the pool ambiguous rather than picking one of them.
+  const domainHit = domainCandidates(byRfq, address);
+  if (domainHit.length) return domainHit;
+  if (!display) return byRfq;
+  const named = byRfq.filter((c) => nameOverlap(display, c));
+  return named.length ? named : byRfq;
+}
+
+/**
+ * Splits "arrived before any invitation existed" into the two very different
+ * things it covers. Mail that names a request is a supplier answering an RFQ
+ * this database no longer has — a decision the owner must see. Mail that names
+ * nothing is newsletters and notifications, which need no decision and, at 124
+ * of 150 messages in a full rescan, bury everything that does.
+ *
+ * The token is the signal on purpose: thread headers would let automated
+ * support desks in, since they reply in threads too.
+ */
+function exclusionReason(reason, { subject, snippet } = {}) {
+  if (reason !== 'NO_ELIGIBLE_INVITE') return reason;
+  return extractRfqTokens(subject, snippet).length ? 'REPLY_TO_UNKNOWN_RFQ' : reason;
+}
+
+/** Reasons recorded for the audit trail but never shown as work to decide. */
+const NON_ACTIONABLE_REASONS = ['NO_ELIGIBLE_INVITE'];
+
+/** Invites whose RFQ id prefix appears as an ELE-RFQ-… token in the message. */
+function rfqTokenCandidates(candidates, requestIds) {
+  if (!requestIds.length) return [];
+  return candidates.filter((c) => requestIds.includes(String(c.rfq_id || '').slice(0, 8).toUpperCase()));
+}
+
+/**
+ * Subject-reference and display-name evidence for a candidate pool.
+ * `from` is a raw From header, `text` any body/snippet to scan for the token.
+ * `tokenInvites` are the company's invites on the RFQ named in the subject —
+ * they may lie outside the candidate pool, which is what lets a wrong
+ * reference contradict the pool instead of reading as no evidence at all.
+ */
+function messageRoutingSignals({ candidates, tokenInvites = [], from, subject, text, sender }) {
+  const address = sender || mailbox(from);
+  const display = fromDisplayName(from);
+  const requestIds = extractRfqTokens(subject, text);
+  const byEmail = address ? candidates.filter((c) => (c.emails || []).includes(address)) : [];
+  const named = address ? tokenInvites.filter((c) => (c.emails || []).includes(address)) : [];
+  const byRfq = rfqTokenCandidates(tokenInvites.length ? tokenInvites : candidates, requestIds);
+  const bySubject = narrowRfqCandidates(byRfq, named.length ? named : byEmail, display, address);
+  const byName = display ? candidates.filter((c) => nameOverlap(display, c)) : [];
+  return { address, display, requestIds, byEmail, byRfq, bySubject, byName };
+}
+
+/** Company-scoped invites on the RFQs named by ELE-RFQ-… tokens in a message. */
+async function loadTokenInvites(client, ownerId, requestIds) {
+  if (!requestIds.length) return [];
+  const result = await client.query(
+    `select i.id,r.id rfq_id,s.name_ar,s.name_en,coalesce(c.emails,'{}'::text[]) emails
+       from construction.rfq_invites i
+       join construction.rfq_versions v on v.id=i.rfq_version_id
+       join construction.rfqs r on r.id=v.rfq_id
+       join construction.suppliers s on s.id=i.supplier_id
+       left join construction.supplier_contacts c on c.supplier_id=i.supplier_id
+      where r.buyer_user_id=$1 and upper(left(r.id::text,8))=any($2::text[]) limit 200`,
+    [ownerId, requestIds],
+  );
+  return result.rows.map((c) => ({ ...c, emails: (c.emails || []).map(mailbox).filter(Boolean) }));
+}
+
+/**
+ * Evidence for an inbound email delivered to a signed reply alias.
+ * ALIAS is authoritative on its own; the other groups narrow a delivery that
+ * decoded several aliases, or contradict one that points at another request.
+ */
+function aliasEvidenceSets({ candidates, signals, references = [], referenced = [] }) {
+  return [
+    { kind: 'ALIAS', present: true, ids: candidates.map((c) => c.id) },
+    { kind: 'SENDER_EMAIL', present: Boolean(signals.address), ids: signals.byEmail.map((c) => c.id) },
+    { kind: 'REFERENCES', present: references.length > 0, ids: referenced },
+    { kind: 'RFQ_SUBJECT', present: signals.requestIds.length > 0, ids: signals.bySubject.map((c) => c.id) },
+    { kind: 'DISPLAY_NAME', present: Boolean(signals.display), ids: signals.byName.map((c) => c.id) },
+  ];
+}
+
+module.exports = {
+  extractRfqTokens,
+  foldName,
+  fromDisplayName,
+  senderLabel,
+  nameOverlap,
+  narrowRfqCandidates,
+  emailDomain,
+  domainCandidates,
+  SHARED_EMAIL_DOMAINS,
+  exclusionReason,
+  NON_ACTIONABLE_REASONS,
+  rfqTokenCandidates,
+  messageRoutingSignals,
+  loadTokenInvites,
+  aliasEvidenceSets,
+};
