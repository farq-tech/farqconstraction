@@ -0,0 +1,209 @@
+'use strict';
+
+/**
+ * The five write paths a granted member must not reach, and the one background
+ * actor that must keep reaching through.
+ *
+ * WHY THIS FILE EXISTS
+ * The owner is about to grant two client contacts `MANAGEMENT`, and he accepted
+ * that they will see all 8 RFQs and 465 invites on one basis only: that they
+ * cannot change anything. Before this gate, five repository methods checked no
+ * role at all — `createRfq`, `sendRfqInvite`, `createRfqVersion`,
+ * `importSuppliers` and `createCustomItem`. Any of them would have made that
+ * acceptance false.
+ *
+ * The opposite failure is the expensive one. `boq-recovery-worker.js` acts with
+ * a synthetic `BUYER` actor that belongs to no person, and the supplier
+ * discovery adoption path calls `importSuppliers` on its behalf. Gating that
+ * import to the three human roles would kill the recovery worker silently: no
+ * error anyone sees, just BOQ requirements that quietly stop being recovered,
+ * discovered weeks later as missing data. So the worker's actor is tested
+ * against the real repository here rather than reasoned about.
+ */
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createMemoryConstructionRepository } = require('../lib/construction/memory-repository');
+const {
+	GRANTABLE_ROLES,
+	PROCUREMENT_WRITE_ROLES,
+	SUPPLIER_WRITE_ROLES,
+	SYSTEM_BOQ_ACTOR_ROLE,
+	canRunBoqPipeline,
+} = require('../lib/construction/roles');
+
+const SCOPE = 'scope-owner';
+const actorWith = (role) => ({ actorId: SCOPE, userId: SCOPE, role });
+
+/** The actor `boq-recovery-worker.js` builds when no human asked. */
+const WORKER_ACTOR = { actorId: SCOPE, userId: SCOPE, role: SYSTEM_BOQ_ACTOR_ROLE };
+
+/** Roles a person can hold that must NOT be able to write procurement. */
+const READ_ONLY_ROLES = GRANTABLE_ROLES.filter((role) => !PROCUREMENT_WRITE_ROLES.includes(role));
+
+function repository() {
+	return createMemoryConstructionRepository({ dispatcher: { dispatch: async () => ({ status: 'SENT' }) } });
+}
+
+function rfqInput() {
+	return {
+		manual_send: true,
+		item_id: 'white-natural-marble-flooring',
+		selected_supplier_ids: ['marble-sa', 'quraishi-marble'],
+		delivery: {
+			site_address: 'الرياض • حي النرجس',
+			required_date: '2026-10-01',
+			unloading_requirement: 'SUPPLIER_UNLOAD',
+			delivery_required: true,
+		},
+		commercial_terms: { currency: 'SAR', payment_terms: 'BANK_TRANSFER' },
+		buyer: {
+			company_name: 'مقاولات فرق',
+			contact_name: 'مسؤول المشتريات',
+			email: 'buyer@example.com',
+			phone: '+966500000000',
+		},
+		line: { farq_spec_id: 'MARBLE-NATURAL-WHITE-VEINED-FLOORING-M2', quantity: 300, uom: 'M2', pack: 'SLAB_OR_TILE' },
+	};
+}
+
+/**
+ * The five gated calls, each with a request that is otherwise well formed.
+ *
+ * Authorization is asserted on its own: a permitted role may still fail on
+ * request content, and that is not a gate failure. So the allowed cases assert
+ * only "not CONSTRUCTION_FORBIDDEN", which is precisely the gate's contract.
+ */
+const WRITE_PATHS = [
+	{
+		name: 'createRfq',
+		call: (repo, actor) => repo.createRfq({ body: rfqInput(), actor, requestId: `r-${actor.role}` }),
+	},
+	{
+		name: 'sendRfqInvite',
+		call: (repo, actor) => repo.sendRfqInvite({ params: { id: 'rfq-1', inviteId: 'invite-1' }, body: {}, actor, requestId: `s-${actor.role}` }),
+	},
+	{
+		name: 'createRfqVersion',
+		call: (repo, actor) => repo.createRfqVersion({ params: { id: 'rfq-1' }, body: rfqInput(), actor }),
+	},
+	{
+		name: 'createCustomItem',
+		call: (repo, actor) =>
+			repo.createCustomItem({
+				actor,
+				body: {
+					name_ar: 'صنف مخصص',
+					name_en: 'Custom item',
+					category: 'electrical',
+					unit: 'EA',
+					specifications: [{ key: 'voltage', name_ar: 'الجهد', name_en: 'Voltage', value: '220V' }],
+				},
+			}),
+	},
+];
+
+const SUPPLIER_IMPORT = {
+	name: 'importSuppliers',
+	call: (repo, actor) =>
+		repo.importSuppliers({
+			actor,
+			body: {
+				suppliers: [{ name_ar: 'مورد', name_en: 'Supplier', email: 'supplier@example.com' }],
+				item_ids: ['white-natural-marble-flooring'],
+			},
+		}),
+};
+
+async function forbiddenCode(call) {
+	try {
+		await call();
+		return null;
+	} catch (error) {
+		return error.code || null;
+	}
+}
+
+test('MANAGEMENT can no longer create a project', async () => {
+	// The last buyer-side write an oversight account could reach. Kept as its
+	// own test because the owner's acceptance of company-wide read visibility
+	// is conditioned on this specific answer.
+	assert.equal(
+		await forbiddenCode(() => repository().createProject({ actor: actorWith('MANAGEMENT'), body: { name: 'مشروع' } })),
+		'CONSTRUCTION_FORBIDDEN',
+	);
+	for (const role of ['ADMIN', 'PROCUREMENT']) {
+		assert.notEqual(
+			await forbiddenCode(() => repository().createProject({ actor: actorWith(role), body: { name: 'مشروع' } })),
+			'CONSTRUCTION_FORBIDDEN',
+			`${role} must still create projects`,
+		);
+	}
+});
+
+test('oversight roles cannot originate or change procurement', async () => {
+	// APPROVER, FINANCE and MANAGEMENT review procurement; they do not create it.
+	assert.deepEqual(READ_ONLY_ROLES, ['APPROVER', 'FINANCE', 'MANAGEMENT']);
+	for (const role of READ_ONLY_ROLES) {
+		for (const path of [...WRITE_PATHS, SUPPLIER_IMPORT]) {
+			assert.equal(
+				await forbiddenCode(() => path.call(repository(), actorWith(role))),
+				'CONSTRUCTION_FORBIDDEN',
+				`${role} must not reach ${path.name}`,
+			);
+		}
+	}
+});
+
+test('buying roles still reach every write path', async () => {
+	for (const role of PROCUREMENT_WRITE_ROLES) {
+		for (const path of [...WRITE_PATHS, SUPPLIER_IMPORT]) {
+			assert.notEqual(
+				await forbiddenCode(() => path.call(repository(), actorWith(role))),
+				'CONSTRUCTION_FORBIDDEN',
+				`${role} must still reach ${path.name}`,
+			);
+		}
+	}
+});
+
+test('an actor with no id is refused before any role comparison', async () => {
+	for (const path of [...WRITE_PATHS, SUPPLIER_IMPORT]) {
+		const code = await forbiddenCode(() => path.call(repository(), { role: 'ADMIN' }));
+		assert.ok(
+			code === 'CONSTRUCTION_FORBIDDEN' || code === 'CONSTRUCTION_AUTH_REQUIRED',
+			`${path.name} must refuse an actor with no id, got ${code}`,
+		);
+	}
+});
+
+test('the BOQ recovery worker actor still reaches everything it uses', async () => {
+	// The worker's role is synthetic, so it must never be grantable — otherwise
+	// the supplier-import allowance below would become human reach.
+	assert.ok(!GRANTABLE_ROLES.includes(SYSTEM_BOQ_ACTOR_ROLE));
+	assert.ok(canRunBoqPipeline(WORKER_ACTOR));
+
+	// matchBoqCatalog is the only repository method boq-recovery-worker.js calls.
+	const catalog = await repository().matchBoqCatalog({
+		actor: WORKER_ACTOR,
+		body: { rows: [{ key: 'j1', name: 'رخام أبيض', quantity: 10, uom: 'M2' }] },
+	});
+	assert.ok(Array.isArray(catalog.rows), 'recovery worker must still match the catalog');
+
+	// And the import the discovery adoption path performs for the pipeline.
+	assert.notEqual(
+		await forbiddenCode(() => SUPPLIER_IMPORT.call(repository(), WORKER_ACTOR)),
+		'CONSTRUCTION_FORBIDDEN',
+		'gating importSuppliers must not break supplier discovery adoption',
+	);
+});
+
+test('the worker actor role stays inside the supplier import allowance', () => {
+	// A guard against the silent failure, not a restatement of the constant.
+	// If someone narrows importSuppliers to the three human roles, this fails
+	// here instead of the recovery worker dying quietly in production.
+	const source = require('fs').readFileSync(require.resolve('../lib/construction/boq-recovery-worker.js'), 'utf8');
+	const role = source.match(/role\s*:\s*["'](\w+)["']/)?.[1];
+	assert.equal(role, SYSTEM_BOQ_ACTOR_ROLE, 'boq-recovery-worker.js no longer builds the actor this gate expects');
+	assert.ok(SUPPLIER_WRITE_ROLES.includes(role), 'the worker actor must keep supplier-import access');
+});
