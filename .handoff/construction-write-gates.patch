diff --git a/api/tests/construction-roles.test.js b/api/tests/construction-roles.test.js
new file mode 100644
index 000000000..2a7fa64f7
--- /dev/null
+++ b/api/tests/construction-roles.test.js
@@ -0,0 +1,96 @@
+'use strict';
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+
+const {
+	GRANTABLE_ROLES,
+	SYSTEM_ROLES,
+	SYSTEM_BOQ_ACTOR_ROLE,
+	BOQ_PIPELINE_ROLES,
+	isGrantableRole,
+	isSystemRole,
+	canRunBoqPipeline,
+} = require('../lib/construction/roles');
+
+const MIGRATIONS_DIR = path.join(__dirname, '..', 'db', 'migrations', 'construction');
+
+/**
+ * The role vocabulary the database will actually accept.
+ *
+ * Read from the migrations rather than hardcoded, and from the LAST definition
+ * in timestamp order — the constraint is created in the foundation migration
+ * and then replaced by a later `alter table ... add constraint`, so only the
+ * final one describes the live schema.
+ */
+function rolesFromMigration() {
+	const pattern = /check\s*\(\s*role\s+in\s*\(([^)]*)\)/gis;
+	let latest = null;
+	for (const file of fs.readdirSync(MIGRATIONS_DIR).sort()) {
+		if (!file.endsWith('.sql')) continue;
+		const sql = fs.readFileSync(path.join(MIGRATIONS_DIR, file), 'utf8');
+		for (const match of sql.matchAll(pattern)) latest = match[1];
+	}
+	assert.ok(latest, 'could not find the access_users role check constraint');
+	return latest
+		.split(',')
+		.map((part) => part.trim().replace(/^'|'$/g, ''))
+		.filter(Boolean);
+}
+
+test('grantable roles match the access_users check constraint exactly', () => {
+	// Drift here is silent and nasty: code offers a role the database refuses,
+	// and an invitation fails at acceptance time with a constraint violation.
+	assert.deepEqual([...GRANTABLE_ROLES].sort(), rolesFromMigration().sort());
+});
+
+test("the worker's synthetic role can never be granted to an account", () => {
+	// This is the invariant worth protecting. 'BUYER' is absent from the DB
+	// constraint on purpose, so no person can hold it — while the BOQ recovery
+	// worker still wears it to act for a company scope with no human request.
+	assert.equal(isSystemRole(SYSTEM_BOQ_ACTOR_ROLE), true);
+	assert.equal(isGrantableRole(SYSTEM_BOQ_ACTOR_ROLE), false);
+	assert.ok(!rolesFromMigration().includes(SYSTEM_BOQ_ACTOR_ROLE));
+	for (const role of SYSTEM_ROLES) assert.equal(isGrantableRole(role), false);
+});
+
+test('the BOQ pipeline accepts the worker actor and the buying roles', () => {
+	// boq-recovery-worker.js builds { actorId, userId, role: 'BUYER' }. Dropping
+	// the synthetic role from these allowlists as "dead code" silently stops
+	// BOQ recovery, which is why it now comes from one named list.
+	assert.ok(BOQ_PIPELINE_ROLES.includes(SYSTEM_BOQ_ACTOR_ROLE));
+	assert.equal(
+		canRunBoqPipeline({ actorId: 'scope-1', role: SYSTEM_BOQ_ACTOR_ROLE }),
+		true,
+	);
+	for (const role of ['ADMIN', 'PROCUREMENT', 'ENGINEER']) {
+		assert.equal(canRunBoqPipeline({ actorId: 'scope-1', role }), true);
+	}
+});
+
+test('the BOQ pipeline refuses read-only roles and unauthenticated callers', () => {
+	for (const role of ['FINANCE', 'MANAGEMENT', 'APPROVER', 'VIEWER', '']) {
+		assert.equal(canRunBoqPipeline({ actorId: 'scope-1', role }), false);
+	}
+	assert.equal(canRunBoqPipeline({ role: 'ADMIN' }), false);
+	assert.equal(canRunBoqPipeline(null), false);
+});
+
+test('an invitation can only ever produce a grantable construction role', () => {
+	// native-invitations.js maps the sector role on an accepted invitation to a
+	// construction role. Every value it can produce must be one the database
+	// accepts, or acceptance fails after the account has already been created.
+	const source = fs.readFileSync(
+		path.join(__dirname, '..', 'lib', 'business', 'native-invitations.js'),
+		'utf8',
+	);
+	const map = /\{\s*ADMIN:\s*"ADMIN",[\s\S]*?\}\[row\.sector_role\]/.exec(source);
+	assert.ok(map, 'could not find the sector-role to construction-role map');
+	const produced = [...map[0].matchAll(/:\s*"([A-Z_]+)"/g)].map((m) => m[1]);
+	assert.ok(produced.length >= 4);
+	for (const role of produced) {
+		assert.equal(isGrantableRole(role), true, `${role} is not grantable`);
+	}
+});
