diff --git a/api/lib/construction/roles.js b/api/lib/construction/roles.js
new file mode 100644
index 000000000..b4c7462f4
--- /dev/null
+++ b/api/lib/construction/roles.js
@@ -0,0 +1,128 @@
+'use strict';
+
+/**
+ * The construction role vocabulary, in one place.
+ *
+ * There are two kinds of role here, and conflating them is a real hazard: the
+ * roles a person can be granted, and a synthetic role only the platform gives
+ * itself. `'BUYER'` looks like dead code from every call site — it is absent
+ * from the `construction.access_users` check constraint, so no row can ever
+ * hold it and no invitation can ever produce it. Deleting it on that reading
+ * would break BOQ recovery, because `boq-recovery-worker.js` builds its own
+ * actor with exactly that role in order to act for a company scope with no
+ * human request behind it.
+ *
+ * So it stays, named and explained, and the invariant that actually matters is
+ * enforced instead: `'BUYER'` must never be grantable to an account.
+ */
+
+/**
+ * Roles assignable to a person.
+ *
+ * MIRRORS the check constraint on `construction.access_users.role`
+ * (db/migrations/construction/20260902065519_construction_role_accounts_scope.sql).
+ * `construction-roles.test.js` fails if the two drift apart.
+ */
+const GRANTABLE_ROLES = Object.freeze([
+	'ADMIN',
+	'ENGINEER',
+	'PROCUREMENT',
+	'APPROVER',
+	'FINANCE',
+	'MANAGEMENT',
+]);
+
+/**
+ * Roles the platform synthesizes for its own background work. No account can
+ * hold one: they exist only on in-memory actors built by workers, which is why
+ * they are deliberately NOT in the database constraint.
+ */
+const SYSTEM_ROLES = Object.freeze(['BUYER']);
+
+/** The role `boq-recovery-worker.js` acts under when no human asked. */
+const SYSTEM_BOQ_ACTOR_ROLE = 'BUYER';
+
+/**
+ * Who may drive the BOQ pipeline — catalog recovery, supplier discovery and
+ * registry search. The buying roles, plus the worker's synthetic actor.
+ *
+ * This list used to be copy-pasted into three modules, which is how it became
+ * unclear whether the synthetic role was load-bearing or leftover.
+ */
+const BOQ_PIPELINE_ROLES = Object.freeze([
+	'ADMIN',
+	'PROCUREMENT',
+	'ENGINEER',
+	SYSTEM_BOQ_ACTOR_ROLE,
+]);
+
+/**
+ * Who may change procurement state — raise an RFQ, send an invite, amend a
+ * version, add a catalog item.
+ *
+ * The roles left out are deliberate. APPROVER, FINANCE and MANAGEMENT are
+ * review and oversight roles: they exist to look at procurement and sign off on
+ * it, not to originate it. MANAGEMENT in particular is what a client contact
+ * gets, and a client must not be able to raise an RFQ or mail a supplier in the
+ * company's name.
+ *
+ * Note this is authorization only. It says nothing about WHICH rows a role can
+ * see — every granted member still reads the whole company scope, because
+ * construction ignores the per-project fields `business` models. See
+ * `.handoff/AUTH_PHASES_0_2_DONE.md`.
+ */
+const PROCUREMENT_WRITE_ROLES = Object.freeze(['ADMIN', 'PROCUREMENT', 'ENGINEER']);
+
+/**
+ * Who may write to the supplier directory.
+ *
+ * The same three human roles, plus the synthetic pipeline actor. That addition
+ * is load-bearing, not a loophole: `adoptDiscoverySupplier` in
+ * supplier-discovery-runtime.js calls `importSuppliers` on the pipeline's
+ * behalf, and it admits BOQ_PIPELINE_ROLES. Gating the import to the three
+ * human roles alone would make that path throw for the worker's actor.
+ *
+ * It grants no human any extra reach, because `'BUYER'` is not grantable — the
+ * `construction.access_users` check constraint cannot store it, and
+ * `construction-roles.test.js` fails if that ever stops being true.
+ */
+const SUPPLIER_WRITE_ROLES = Object.freeze([...PROCUREMENT_WRITE_ROLES, SYSTEM_BOQ_ACTOR_ROLE]);
+
+/** True when `actor` may originate or change procurement state. */
+function canWriteProcurement(actor) {
+	return Boolean(actor?.actorId) && PROCUREMENT_WRITE_ROLES.includes(actor.role);
+}
+
+/** True when `actor` may write to the supplier directory. */
+function canWriteSuppliers(actor) {
+	return Boolean(actor?.actorId) && SUPPLIER_WRITE_ROLES.includes(actor.role);
+}
+
+/** True when `role` may be assigned to a person. */
+function isGrantableRole(role) {
+	return GRANTABLE_ROLES.includes(String(role || '').trim().toUpperCase());
+}
+
+/** True when `role` is only ever worn by platform background work. */
+function isSystemRole(role) {
+	return SYSTEM_ROLES.includes(String(role || '').trim().toUpperCase());
+}
+
+/** True when `actor` may drive the BOQ pipeline. */
+function canRunBoqPipeline(actor) {
+	return Boolean(actor?.actorId) && BOQ_PIPELINE_ROLES.includes(actor.role);
+}
+
+module.exports = {
+	GRANTABLE_ROLES,
+	SYSTEM_ROLES,
+	SYSTEM_BOQ_ACTOR_ROLE,
+	BOQ_PIPELINE_ROLES,
+	PROCUREMENT_WRITE_ROLES,
+	SUPPLIER_WRITE_ROLES,
+	isGrantableRole,
+	isSystemRole,
+	canRunBoqPipeline,
+	canWriteProcurement,
+	canWriteSuppliers,
+};
