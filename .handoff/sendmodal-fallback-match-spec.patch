+
+const parseQty = (qty: string) => Number(String(qty).replace(/,/g, '')) || 1
+
+function itemsFrom(uploadAnswers: Record<string, string | null>): BOQItem[] {
+  return fixture.lines.map((line) => ({
+    id: line.id,
+    name: line.name,
+    qty: line.qty,
+    unit: line.unit,
+    spec: line.spec,
+    status: 'ready',
+    supplierCount: 3,
+    suppliers: [],
+    farqSpecId: uploadAnswers[line.lineKey] || undefined,
+    lineKey: line.lineKey,
+  }))
+}
+
+const build = (items: BOQItem[], answers: Record<string, string | null>) =>
+  buildRfqLinesFromItems(items, {
+    specIdForLine: (key) => answers[key] ?? undefined,
+    // The client adapter never returns a uom, so this cannot contribute.
+    uomForLine: () => undefined,
+    parseQty,
+  })
+
+/** The payload SendModal builds for the fallback. */
+const payloadFor = (items: BOQItem[]) =>
+  items
+    .filter((item) => !item.farqSpecId)
+    .map((item) => ({
+      line_key: item.lineKey || `line-${item.id}`,
+      name_ar: item.name,
+      quantity: parseQty(item.qty),
+      uom: item.unit || 'عدد',
+      spec: item.spec,
+    }))
+
+describe("SendModal's fallback boq/match call", () => {
+  it('leaves every RFQ line identical by content, not just by count', () => {
+    const items = itemsFrom(fixture.upload)
+    const asItWas = build(items, fixture.fallbackBare)
+    const narrowed = build(items, fixture.narrowedBare)
+    const shipping = build(items, fixture.narrowedWithSpec)
+
+    // Narrowing changed nothing, and sending the spec changed nothing either.
+    expect(narrowed).toEqual(asItWas)
+    expect(shipping).toEqual(asItWas)
+    expect(JSON.stringify(shipping)).toBe(JSON.stringify(asItWas))
+
+    // Not a vacuous pass: state what these lines are.
+    expect(shipping).toHaveLength(69)
+    expect(shipping.filter((l) => l.farq_spec_id)).toHaveLength(39)
+    expect(shipping.filter((l) => l.farq_spec_id === null)).toHaveLength(30)
+    // Each line keeps its own name — the wrong-name regression stays fixed.
+    for (const [i, line] of shipping.entries()) {
+      expect(line.name_ar).toBe(fixture.lines[i]!.name)
+      expect(line.original_name).toBe(fixture.lines[i]!.name)
+    }
+  })
+
+  it('asks about exactly the unresolved lines, and cannot alter the rest', () => {
+    const items = itemsFrom(fixture.upload)
+    const asked = payloadFor(items).map((l) => l.line_key).sort()
+    expect(asked).toEqual(Object.keys(fixture.narrowedWithSpec).sort())
+    expect(asked).toHaveLength(30)
+    const built = build(items, fixture.narrowedWithSpec)
+    for (const item of items.filter((i) => i.farqSpecId)) {
+      expect(built.find((l) => l.line_key === item.lineKey)?.farq_spec_id).toBe(item.farqSpecId)
+    }
+  })
+
+  it('sends the technical column for every line it asks about', () => {
+    // The omission this guards against: the field is on the item, so leaving it
+    // out of the payload is silent and costs accuracy rather than erroring.
+    const payload = payloadFor(itemsFrom(fixture.upload))
+    expect(payload).toHaveLength(30)
+    for (const line of payload) {
+      const source = fixture.lines.find((l) => l.lineKey === line.line_key)!
+      expect(line.spec).toBe(source.spec)
+      expect(line.spec).toBeTruthy()
+    }
+  })
+
+  it('agrees with the upload once it sends the same field', () => {
+    // Without the column the fallback named a different material on two lines.
+    const diverged = Object.keys(fixture.upload).filter(
+      (key) => fixture.upload[key] !== fixture.fallbackBare[key],
+    )
+    expect(diverged).toEqual(['line-48', 'line-51'])
+    expect(fixture.upload['line-48']).toBe('indoor-lighting')
+    expect(fixture.fallbackBare['line-48']).toBe('lighting')
+    expect(fixture.upload['line-51']).toBe('ppr-pipes')
+    expect(fixture.fallbackBare['line-51']).toBe('pvc-pipe')
+
+    // Both are lines the upload resolved, so narrowing already stops the
+    // fallback being consulted for them — and with the column sent, the whole
+    // class of disagreement is gone: the fallback agrees with the upload on
+    // every line it is asked about.
+    const items = itemsFrom(fixture.upload)
+    const askedKeys = new Set(payloadFor(items).map((l) => l.line_key))
+    expect(askedKeys.has('line-48')).toBe(false)
+    expect(askedKeys.has('line-51')).toBe(false)
+    for (const key of askedKeys) {
+      expect(fixture.narrowedWithSpec[key]).toBe(fixture.upload[key])
+    }
+  })
+
+  it('builds that payload in SendModal itself, not only here', () => {
+    // payloadFor above mirrors SendModal's construction, so on its own it cannot
+    // catch the field being dropped from the view again — which is the bug this
+    // file exists for. Bind to the source too. If a later change to the send
+    // handler trips this, that is the right moment for a human to look: this
+    // payload decides which suppliers are asked to quote.
+    const source = readFileSync(new URL('../views/SendModal.tsx', import.meta.url), 'utf8')
+    const block = source.slice(source.indexOf('const matchPayload'), source.indexOf('const matched'))
+    expect(block).toContain('spec: item.spec')
+    expect(block).toContain('needSpecId')
+    expect(source).toContain('readyItems.filter((item) => !item.farqSpecId)')
+  })
+
+  it('still resolves every line when the upload match failed entirely', () => {
+    // parseBoq swallows a failed upload match, leaving every item without a spec
+    // id — narrowing then selects all of them, so nothing is lost.
+    const items = itemsFrom({})
+    expect(payloadFor(items)).toHaveLength(69)
+    expect(build(items, fixture.upload).filter((l) => l.farq_spec_id)).toHaveLength(39)
+  })
+})
